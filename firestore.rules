rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private: only the owner can read/write their own profile (history, last donation)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Public donor card: any signed-in user can read; only the owner can write
    match /donors/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Blood requests: signed-in users read; owner creates/updates/deletes
    match /requests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
